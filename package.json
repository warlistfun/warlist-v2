{
  "name": "@warlist/core",
  "version": "0.0.0",
  "description": "WARLIST 2.0 backend foundation",
  "scripts": {
    "test": "node --import tsx --test test/**/*.test.ts && npm run test:web",
    "test:web": "vitest run --config web/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test:unit": "node --import tsx --test test/unit/**/*.test.ts",
    "test:architecture": "node --import tsx --test test/architecture/**/*.test.ts",
    "debug:automation": "tsx src/debug-automation.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "check:boundary": "node scripts/check-repository-boundary.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:boundary"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warlistfun/warlist-v2.git"
  },
  "bugs": {
    "url": "https://github.com/warlistfun/warlist-v2/issues"
  },
  "homepage": "https://github.com/warlistfun/warlist-v2#readme",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.8.1",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  }
}
